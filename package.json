{
  "name": "iwacu-rwanda",
  "version": "0.1.0",
  "private": true,
  "description": "IWACU RWANDA — Nationwide civic geospatial platform for locating villages and local leaders",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:location": "tsx --test src/lib/location-ranking.test.ts src/lib/representative-location.test.ts",
    "db:migrate": "echo 'Run sql/schema.sql against your Supabase project via the SQL Editor'",
    "ingest:boundaries": "tsx scripts/ingest-boundaries.ts",
    "download:boundaries": "tsx scripts/download-rwanda-boundaries.ts",
    "ingest:national-boundaries": "npm run download:boundaries && npm run ingest:boundaries -- public/offline/rwanda-village-boundaries.geojson"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.0",
    "@turf/turf": "^7.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "groq-sdk": "^0.9.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@types/geojson": "^7946.0.14",
    "typescript": "^5.7.2",
    "tailwindcss": "^3.4.16",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
